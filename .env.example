# Copy this file to .env and adjust values if your ports differ:
#
#     cp .env.example .env        (macOS / Linux / WSL)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# .env is gitignored. Never put real secrets or real user data in it, and
# never commit it. This example file contains local development placeholders.

# PostgreSQL - read by compose.yaml to create the container, and by the
# backend to build DATABASE_URL. One source of truth, two consumers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=itsm
POSTGRES_PASSWORD=itsm_local_dev_only
POSTGRES_DB=itsm

# Origin the backend allows through CORS. The Vite dev server proxies /api,
# so this is a fallback for a built frontend served from a different origin.
FRONTEND_ORIGIN=http://localhost:5173

# Generate a different value on each machine: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set this in .env before using login. Never commit the generated value.
JWT_SECRET=

# Where T07 stores attachment bytes (PDF, PNG, JPEG, TXT). Optional: leave it
# unset to use var/uploads beside the repository root, which is gitignored and
# created on first upload. A relative path is resolved against that root.
# No static route serves this directory, so it stays outside the web app.
# UPLOAD_DIR=var/uploads
